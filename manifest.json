{
  "manifest_version": 3,
  "name": "Nvidia Multimodal Assistant",
  "version": "1.0",
  "description": "Analiza imágenes locales usando la API multimodal de NVIDIA",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://integrate.api.nvidia.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
